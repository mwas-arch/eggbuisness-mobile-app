<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="eggs_accounting_app.Pages.SuppliersPage"
    Title="Suppliers">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="SUPPLIERS"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- ADD SUPPLIER -->

            <Border
                Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Add New Supplier"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="SupplierNameEntry"
                        Placeholder="Supplier Name" />

                    <Entry
                        x:Name="SupplierPhoneEntry"
                        Placeholder="Phone Number"
                        Keyboard="Telephone" />

                    <Entry
                        x:Name="SupplierEmailEntry"
                        Placeholder="Email Address"
                        Keyboard="Email" />

                    <Entry
                        x:Name="SupplierAddressEntry"
                        Placeholder="Address" />

                    <Button
                        x:Name="AddSupplierButton"
                        Text="Add Supplier"
                        Clicked="OnAddSupplierClicked" />

                </VerticalStackLayout>

            </Border>

            <Button
                x:Name="RefreshButton"
                Text="Refresh Suppliers"
                Clicked="OnRefreshClicked" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <!-- SUPPLIER LIST -->

            <Label
                Text="Supplier List"
                FontSize="22"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="SuppliersList"
                EmptyView="No suppliers found">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Phone}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Email}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Address}"
                                    FontSize="15" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

