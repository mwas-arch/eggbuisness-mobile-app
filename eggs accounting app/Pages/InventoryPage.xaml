<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="eggs_accounting_app.Pages.InventoryPage"
    Title="Inventory">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="INVENTORY"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Button
                x:Name="AddBatchButton"
                Text="Add Inventory Batch"
                Clicked="OnAddBatchClicked" />

            <VerticalStackLayout
                x:Name="AddBatchForm"
                IsVisible="False"
                Spacing="10">

                <Label
                    Text="ADD INVENTORY BATCH"
                    FontSize="22"
                    FontAttributes="Bold" />

                <Label Text="Supplier" />

                <Picker
                    x:Name="SupplierPicker"
                    Title="Select supplier" />

                <Label Text="Grade" />

                <Picker
                    x:Name="GradePicker"
                    Title="Select egg grade">

                    <Picker.Items>
                        <x:String>Small</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Large</x:String>
                        <x:String>Extra Large</x:String>
                        <x:String>Jumbo</x:String>
                    </Picker.Items>

                </Picker>

                <Label Text="Number of crates" />

                <Entry
                    x:Name="CratesEntry"
                    Placeholder="e.g. 10"
                    Keyboard="Numeric" />

                <Label Text="Eggs per crate" />

                <Entry
                    x:Name="EggsPerCrateEntry"
                    Text="30"
                    Keyboard="Numeric" />

                <Label Text="Cost per crate (Ksh)" />

                <Entry
                    x:Name="CostPerCrateEntry"
                    Placeholder="e.g. 450"
                    Keyboard="Numeric" />

                <Label Text="Received date" />

                <DatePicker
                    x:Name="ReceivedDatePicker" />

                <Button
                    Text="Save Inventory Batch"
                    Clicked="OnSaveBatchClicked" />

                <Button
                    Text="Cancel"
                    Clicked="OnCancelBatchClicked" />

                <ActivityIndicator
                    x:Name="SaveBatchIndicator"
                    IsVisible="False"
                    IsRunning="False" />

                <Label
                    x:Name="BatchMessageLabel"
                    FontSize="14" />

            </VerticalStackLayout>

            <BoxView
                HeightRequest="1"
                Margin="0,5" />

            <Button
                x:Name="RefreshButton"
                Text="Refresh Inventory"
                Clicked="OnRefreshClicked" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <CollectionView
                x:Name="InventoryList"
                EmptyView="No inventory found">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Grade}"
                                    FontSize="21"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding EggsRemaining, StringFormat='Total eggs: {0}'}"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding RemainingCrates, StringFormat='Crates: {0}'}"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding RemainingLooseEggs, StringFormat='Loose eggs: {0}'}"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding CostPerCrate, StringFormat='Cost per crate: Ksh {0:N2}'}"
                                    FontSize="16" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>