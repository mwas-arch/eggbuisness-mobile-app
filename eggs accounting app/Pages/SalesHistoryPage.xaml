<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="eggs_accounting_app.Pages.SalesHistoryPage"
    Title="Sales History">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="SALES HISTORY"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            x:Name="RefreshButton"
            Text="Refresh Sales"
            Clicked="OnRefreshClicked" />

        <ActivityIndicator
            x:Name="LoadingIndicator"
            IsVisible="False"
            IsRunning="False" />

        <CollectionView
            x:Name="SalesList"
            EmptyView="No sales found">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="{Binding SaleNumber}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding CustomerName}"
                                FontSize="15" />

                            <Label
                                Text="{Binding SaleDate}"
                                FontSize="14" />

                            <Label
                                Text="{Binding PaymentMethod}"
                                FontSize="14" />

                            <Label
                                Text="{Binding TotalAmount}"
                                FontSize="16"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding AmountPaid}"
                                FontSize="14" />

                            <Label
                                Text="{Binding BalanceDue}"
                                FontSize="14" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>